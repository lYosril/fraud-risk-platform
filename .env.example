# Copy to `.env` and adjust locally:
#   PowerShell : Copy-Item .env.example .env
#   POSIX      : cp .env.example .env
#
# PLACEHOLDER VALUES ONLY.
# Never put real credentials, real cardholder data, or production hosts in this file,
# and never commit the resulting `.env`. Every value below is an obvious non-secret, so a
# misconfigured deployment fails visibly instead of silently connecting to something real.
#
# Secrets (POSTGRES_PASSWORD, and the credentials inside DATABASE_URL) are read from the
# environment only. No secret in this project has a usable default, and in production
# APP_ENV=production makes the application refuse to start unless a real database target and
# credentials are supplied.
#
# Keep comments on their own lines: inline `KEY=value # comment` is parsed
# inconsistently between dotenv implementations and Docker Compose.

# ---- Application -------------------------------------------------------------
# One of: local | test | staging | production
APP_ENV=local
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ---- API ---------------------------------------------------------------------
# Where the API process binds. 127.0.0.1 keeps public scoring off the network by default.
API_HOST=127.0.0.1
API_PORT=8000
# Mount point for the routers. Must start with "/" and must not end with "/".
# Use an empty value to serve at the root.
API_PREFIX=/api/v1
# Comma-separated browser origins allowed to call the API. Empty means no CORS headers.
# Staging/production require explicit origins; a wildcard is rejected outside local/test.
# Local dashboard example: CORS_ALLOWED_ORIGINS=http://localhost:8501
CORS_ALLOWED_ORIGINS=
# Bearer token for the administrative routes:
#   GET /api/v1/model
#   GET /api/v1/predictions
#   GET /api/v1/predictions/summary
#   GET /api/v1/predictions/{prediction_id}
#   PATCH /api/v1/predictions/{prediction_id}/review
# At least 16 characters when set. Leave blank to disable those routes (they return 503);
# they never fall back to anonymous access. Inject the real value from a secret manager in
# deployed environments. Never commit it.
API_ADMIN_TOKEN=
# Maximum number of transactions accepted by POST /api/v1/predict/batch.
BATCH_MAX_SIZE=100
# Maximum HTTP request body size in bytes, enforced before JSON parsing.
API_MAX_REQUEST_BYTES=1048576

# ---- Dashboard ---------------------------------------------------------------
# Where the dashboard reaches the API. This is deliberately separate from API_HOST/API_PORT,
# which are where *this* process binds: inside containers those are not the same value.
# The dashboard also uses API_ADMIN_TOKEN above to read the protected overview/history routes.
# Run it with: streamlit run src/fraud_risk/dashboard/app.py
DASHBOARD_API_URL=http://localhost:8000

# ---- PostgreSQL --------------------------------------------------------------
# Consumed both by docker-compose (to create the container) and by the application.
POSTGRES_USER=fraud
POSTGRES_PASSWORD=123456
POSTGRES_DB=fraud
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional override. When set it wins over the POSTGRES_* values above and must be a
# PostgreSQL SQLAlchemy URL, e.g.:
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
# DATABASE_URL=

# ---- MLflow ------------------------------------------------------------------
# The default is a local SQLite store, so no MLflow server is required for development.
# Inspect it with:  mlflow ui --backend-store-uri sqlite:///mlflow.db
# Point this at http://localhost:5000 (or a real tracking server) to use a shared server.
# MLflow 3.x treats the plain `./mlruns` filesystem backend as maintenance mode; if you
# insist on it, set MLFLOW_ALLOW_FILE_STORE=true in your own environment.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=fraud-detection

# ---- Training cost model (provisional) --------------------------------------
# Abstract cost units, not currency. One missed fraud (false negative) is assumed to cost
# this many times one false alarm (false positive). Training picks each candidate's threshold
# and the winning model on validation by minimising these costs, so changing a value can
# change the selected model. Confirm the real weights before acting on them
# (docs/ARCHITECTURE.md 13.2).
FALSE_NEGATIVE_COST=100
FALSE_POSITIVE_COST=1

# ---- Model artifact management ----------------------------------------------
MODEL_NAME=fraud-risk-classifier
# Registry alias resolved at inference time. Promoted deliberately, never automatically.
MODEL_ALIAS=champion
# Directory holding published artifact bundles (registry layout, later milestones).
MODEL_DIR=./artifacts/models
# The artifact the inference service loads by default. This is the model frozen by
# `python -m fraud_risk.models.final_evaluation`. In a deployment, point it at the promoted
# bundle instead; the service validates the bundle before serving a request.
MODEL_ARTIFACT_PATH=./artifacts/final_evaluation/frozen_model.joblib

# ---- Reproducibility --------------------------------------------------------
# One seed for every randomised step (train/validation/test split, CV folds, estimator
# initialisation). Change it deliberately when comparing runs, never to "fix" a result.
RANDOM_SEED=42

# ---- Decision policy ---------------------------------------------------------
# Three-way policy, see docs/ARCHITECTURE.md §6. The values in force are stored with
# every prediction, so changing them does not rewrite history.
# review <= score < block -> review queue ; score >= block -> block
REVIEW_THRESHOLD=0.30
BLOCK_THRESHOLD=0.70

# ---- Inference / persistence -------------------------------------------------
# Persisting the input feature vector enables drift analysis but has storage and
# privacy costs. Disabled by default; decide per environment (ARCHITECTURE §13.4).
PERSIST_FEATURE_SNAPSHOT=false

# ------------------------------------------------------------------------------
# Running with APP_ENV=production
# ------------------------------------------------------------------------------
# The application validates the following at startup and refuses to boot otherwise, so that
# a development default can never silently reach production:
#
#   1. A database target must be configured explicitly. Either set DATABASE_URL (preferred;
#      it carries its own credentials), or set POSTGRES_PASSWORD from the environment.
#   2. POSTGRES_PASSWORD must not be one of the placeholders committed in this file.
#
# Strongly recommended for every deployed environment:
#   3. Set API_ADMIN_TOKEN from a secret manager to enable model metadata, history and review.
#      If it is unset those routes return 503; they never become public.
#   4. Terminate TLS at a reverse proxy/load balancer and keep API_HOST on a private interface.
#      The application does not terminate TLS itself.
#
# Example production-shaped values (placeholders — inject the real ones from your secret
# manager / orchestrator, never from a committed file):
#   APP_ENV=production
#   API_ADMIN_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_16_CHARS
#   DATABASE_URL=postgresql+psycopg://fraud:REPLACE_WITH_SECRET@db.internal:5432/fraud
#   MLFLOW_TRACKING_URI=http://mlflow.internal:5000
